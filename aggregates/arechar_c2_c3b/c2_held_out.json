  "design": {
   "kernel": "jev-1.13.0",
   "phrasing": "p3 (one Noul per option, renormalised)",
   "stimulus": "the US English headline, and the US instructions, pretest wording, neutral headline and tips, taken from CRUS.qsf and given in the order participants read them (windtunnel.eval.arechar.context_for)",
