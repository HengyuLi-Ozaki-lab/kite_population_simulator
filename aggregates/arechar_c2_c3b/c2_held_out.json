   "stability": "headline-level agreement is flat from 100 simulated respondents per condition upward (0.70 sharing, 0.87 accuracy)"
  },
  "gates": {
   "item_and_person": {
    "per_part": {
     "headline_level": "For sharing (share-only condition) and for accuracy (accuracy condition): the correlation across headlines between the model's mean expected rating and the human mean rating is above the item-shuffle null's 95th percentile with permutation p < 0.01. In new_headlines this is one test per measure; in the two fifteen- country parts it has to hold in at least 12 of 15 countries for each measure.",
     "discernment": "In the accuracy condition the model rates true headlines above false ones by more than the truth-shuffle null's 95th percentile - once in new_headlines, in at least 12 of 15 countries in the other parts.",
     "individual_level": "Within (country, headline, condition), the correlation between the model's expected rating and the person's rating is above the people-shuffle null's 95th percentile, pooled over the part."
    },
    "passes_if": "every per-part criterion holds in all three parts",
    "note": "\"12 of 15\" is a design choice, not a calibrated number: no non-US data can be looked at before this file is committed. Under the null each country passes about 5% of the time."
   },
   "intervention": {
    "per_part_and_treatment": "For the prompt and for the tips, the effect on sharing discernment (treatment minus share-only), pooled with equal weight per country: PASS if the model's pooled effect is above its condition-shuffle null's 95th percentile AND the human pooled effect is positive with a 95% interval above zero. FAIL if the human effect is reliably positive and the model's is not. NOT APPLICABLE if the human interval includes zero.",
    "reported_without_a_threshold": "per-country sign agreement on the countries whose human interval excludes zero",
    "prediction_on_record": "The calibration makes a FAIL on the prompt likely: on US x A the model's effect was -0.029, inside its null band, while people's was +0.151. The design is not re-tuned to change that - wording the context so that it names the mechanism would tell the model the answer instead of testing whether it can infer it."
   }
  },
  "moderator": {
   "questionnaire_language": {
    "english": [
